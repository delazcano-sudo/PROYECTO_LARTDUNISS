{
  "info": {
    "_postman_id": "6c1e72a8-4f9b-4fcb-82ad-3e8c7a1a9d41",
    "name": "LARTDUNISS Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Registrar Usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"{{username}}\",\n  \"clave\": \"{{password}}\",\n  \"correo\": \"{{email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios/registrar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios",
            "registrar"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Login Usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const token = pm.response.text().trim();",
              "if (token) {",
              "    pm.environment.set('token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"{{username}}\",\n  \"clave\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Perfil Token (Echo Header en Gateway)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios/v3/api-docs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios",
            "v3",
            "api-docs"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090"
    },
    {
      "key": "username",
      "value": "postmanuser"
    },
    {
      "key": "password",
      "value": "123456"
    },
    {
      "key": "email",
      "value": "postmanuser@mail.com"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
